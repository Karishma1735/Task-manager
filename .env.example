# Copy to .env.local and fill in. Never commit real credentials.
APP_TZ=Asia/Kolkata
COMMIT_BY_HOUR=11
DATABASE_PATH=./data/value-ledger.db
# Long random string (>= 32 chars). Generate: openssl rand -hex 32
SESSION_SECRET=
# Used only by `npm run db:seed` (and optional password reset on re-seed).
OWNER_NAME=Owner
OWNER_EMAIL=
OWNER_PASSWORD=
REVIEWER_NAME=Reviewer
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# --- viaSocket (Phase 3). Server-side only: never exposed to the browser, logs or API responses. ---
# Public base URL used in report links inside events (no trailing slash).
APP_BASE_URL=http://localhost:3000
# Webhook URLs of the three event flows: https://flow.sokt.io/func/<script_id>
VIASOCKET_HOOK_COMMIT=
VIASOCKET_HOOK_REPORT=
VIASOCKET_HOOK_REVIEW=
# Secret every flow checks in its first step (openssl rand -hex 24).
VIASOCKET_SHARED_TOKEN=

# --- Scheduled flows (Phase 4) ---
# Secret the scheduled viaSocket flows send in the x-reminder-token header (>= 16 chars; openssl rand -hex 24).
REMINDER_TOKEN=
# Reminders and the weekly digest are OFF until you set this to 1 (after approving the destinations).
SCHEDULED_REMINDERS_ENABLED=0
